# Chave aleatória de no mínimo 32 bytes em base64url. Nunca use NEXT_PUBLIC_.
AUTH_JWS_SECRET=
# API futura: POST HTTPS recebe email, password, profile; retorna id, name, role.
AUTH_LOGIN_URL=
# Origem pública exata em produção, por exemplo https://pethub.example
AUTH_APP_ORIGIN=
# Conta de demonstração apenas em NODE_ENV=development.
AUTH_DEV_LOGIN_ENABLED=false
